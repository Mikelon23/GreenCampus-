# ─── Documentación privada ────────────────────────────────────────
docs/          # carpeta de specs/diseño local (no se versiona)
*.prompt       # archivos de prompt de herramientas AI

# ─── Variables de entorno / secretos ──────────────────────────────
.env
.env.local
.env.*.local
.env.*
!.env.example   # plantillas sin secretos → SÍ versionar

# ─── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
*.pyz
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.python-version

# Dependencias locales (equivalente a node_modules)
backend/_deps/
backend/_deps_compat/

# Caché de pytest
backend/pytest-cache-files-*/
backend/pytest-cache-files-*

# ─── Node / Next.js ───────────────────────────────────────────────
node_modules/
.next/
dist/
out/
build/
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts   # generado automáticamente por Next.js

# ─── Docker ───────────────────────────────────────────────────────
# Los archivos de Docker se versionan, pero no datos de volúmenes
docker-volumes/
postgres-data/

# ─── Logs y archivos de runtime ───────────────────────────────────
*.log
*.err
logs/
uvicorn.*.log
uvicorn.*.err
frontend/devserver.log
frontend/prodserver.log
frontend/next.dev.*

# ─── Base de datos / artefactos locales ───────────────────────────
*.sqlite3
*.db
*.dump
*.sql.bak

# ─── Uploads de usuario (runtime, no código) ──────────────────────
backend/uploads/

# ─── Tests / cobertura ────────────────────────────────────────────
htmlcov/
.coverage
.coverage.*
coverage.xml
coverage/
*.coveragerc

# ─── OS / Editor ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
thumbs.db
desktop.ini
ehthumbs.db
