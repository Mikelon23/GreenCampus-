# ─── Base de datos ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greencampusplus
DATABASE_URL=postgresql://postgres:postgres@db:5432/greencampusplus

# ─── Backend / JWT ────────────────────────────────────────────────
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Admin inicial (seed) ─────────────────────────────────────────
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=admin1234

# ─── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── Simulador (opcional) ─────────────────────────────────────────
SIM_API_BASE_URL=http://backend:8000
SIM_INTERVAL_SECONDS=5
SIM_ZONE_IDS=
SIM_AUTH_TOKEN=
